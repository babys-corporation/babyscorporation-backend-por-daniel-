# Configurações Django
MODE=PRODUCTION
DEBUG=False
SECRET_KEY=your-secret-key-here

# Banco de dados
# No Fabroku (Dokku/Postgres), ao vincular o serviço PostgreSQL à aplicação,
# a variável DATABASE_URL será injetada automaticamente pela plataforma.
# Para desenvolvimento local, pode usar SQLite (padrão) ou uma URL Postgres local.
# DATABASE_URL=postgres://user:password@host:port/database

# Cloudinary (obrigatório em produção conforme configuração atual)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=

# Efí / PIX (opcionais)
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERTIFICATE_PATH=
EFI_CERTIFICATE_BASE64=
EFI_CERTIFICATE_PASSWORD=
EFI_PIX_KEY=
EFI_SANDBOX=False
EFI_CHARGE_EXPIRATION=3600
EFI_WEBHOOK_URL=
