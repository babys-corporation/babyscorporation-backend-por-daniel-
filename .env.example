# Configurações Django
MODE=PRODUCTION
DEBUG=False
SECRET_KEY=your-secret-key-here

# Hosts e origens (produção no Vercel)
# ALLOWED_HOSTS=.vercel.app,seu-backend.vercel.app
# CSRF_TRUSTED_ORIGINS_EXTRA=https://seu-backend.vercel.app
# CORS_ALLOWED_ORIGINS_EXTRA=https://seu-frontend.vercel.app

# Banco de dados
# O Vercel NÃO fornece PostgreSQL gerenciado. Use um Postgres público
# (Neon, Supabase, Railway etc.) acessível pela internet, com SSL.
# Configure DATABASE_URL nas Environment Variables do projeto no Vercel.
# Exemplo de formato (não use credenciais reais aqui):
# DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# Cloudinary (obrigatório em produção conforme configuração atual)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=

# PIX / Celcoin (opcionais)
PIX_GATEWAY=mock
PIX_CELCOIN_BASE_URL=https://sandbox.openfinance.celcoin.dev
PIX_CELCOIN_CLIENT_ID=
PIX_CELCOIN_CLIENT_SECRET=
PIX_WEBHOOK_TOKEN=
